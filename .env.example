# Sao chép thành .env.local khi chạy thử với Vercel CLI. Trên Vercel thì khai báo ở Settings → Environment Variables.
# Không có 3 biến này thì chạy local bằng file data/guests.sample.json; trên Vercel sẽ trả 503 not_configured.

# ID của Google Sheet: phần giữa /d/ và /edit trong link Sheet
SHEET_ID=

# Email của service account (dạng ten@du-an.iam.gserviceaccount.com), phải được chia sẻ quyền Editor vào Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key trong file JSON của service account. Giữ nguyên các ký tự \n, đặt trong dấu nháy kép.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Không bắt buộc. Key của Maps Embed API cho khung Google Map. Key này lộ trong link iframe nên phải giới hạn
# trong Google Cloud: Application restrictions = tên miền của site, API restrictions = chỉ Maps Embed API.
GOOGLE_MAPS_EMBED_KEY=
